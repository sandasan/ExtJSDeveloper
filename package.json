{
  "name": "extjs-navigator",
  "displayName": "ExtJS Navigator",
  "description": "Navigate Ext JS classes, aliases, and xtypes in your workspace.",
  "version": "0.3.0",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sandasan/ExtJSDeveloper.git"
  },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages", "Other"],
  "keywords": ["ExtJS", "Ext JS", "Sencha", "xtype", "navigation"],
  "main": "./src/extension.js",
  "scripts": {
    "test": "node tests/parser.test.js"
  },
  "activationEvents": ["workspaceContains:**/*.js", "workspaceContains:**/app.json", "onView:extjsExplorer", "onView:extjsDependencies", "onCommand:extjsNavigator.refreshIndex", "onCommand:extjsNavigator.openClass", "onCommand:extjsNavigator.generateElement"],
  "contributes": {
    "commands": [
      { "command": "extjsNavigator.refreshIndex", "title": "ExtJS: Refresh Workspace Index" },
      { "command": "extjsNavigator.openClass", "title": "ExtJS: Open Class or xtype" },
      { "command": "extjsNavigator.generateElement", "title": "ExtJS: Generate Element" }
    ],
    "views": {
      "explorer": [
        { "id": "extjsExplorer", "name": "ExtJS Classes" },
        { "id": "extjsDependencies", "name": "ExtJS Dependencies" }
      ]
    },
    "configuration": {
      "title": "ExtJS Navigator",
      "properties": {
        "extjsNavigator.exclude": { "type": "array", "default": ["**/node_modules/**", "**/build/**", "**/packages/**/build/**"], "items": { "type": "string" }, "description": "Glob patterns excluded from the ExtJS class index." },
        "extjsNavigator.sourceRoots": { "type": "array", "default": [], "items": { "type": "string" }, "description": "Additional source folders to index, relative to each workspace folder unless an absolute path is provided." },
        "extjsNavigator.frameworkVersion": { "type": "string", "default": "", "description": "Override the Ext JS version used by the element generator when local framework metadata is unavailable or ambiguous." }
      }
    }
  }
}
